{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "$deviceId": {
        ".read": true,
        ".write": false,
        "latest": {
          ".read": true
        },
        "history": {
          ".read": true
        },
        "historyByDay": {
          "$date": {
            ".read": true
          }
        }
      }
    },
    "mqtt_data": {
      ".read": false,
      ".write": false
    }
  }
}